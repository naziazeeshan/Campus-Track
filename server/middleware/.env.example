# Copy this file to .env and fill in the values
PORT=5000
# Local MongoDB (Compass):  mongodb://127.0.0.1:27017/campus-track
# MongoDB Atlas:            mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campus-track
MONGO_URI=mongodb://127.0.0.1:27017/campus-track
# Use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
